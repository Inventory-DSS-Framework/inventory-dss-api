APP_NAME="Inventory DSS API"
APP_ENV=development
# true echoes every SQL statement (very noisy) — keep false unless debugging queries.
APP_DEBUG=false
API_V1_PREFIX=/api/v1

# Load the PetHouse demo company once on an empty database (scripts/bootstrap_demo.py).
SEED_DEMO=false

# Local dev DB (inventory-dss-infra compose) is published on host port 5433.
DATABASE_URL=postgresql+psycopg://user:password@localhost:5433/inventory_dss

# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000
# Optional regex for dynamic origins (Railway: https://.*\.up\.railway\.app)
CORS_ORIGIN_REGEX=

JWT_SECRET_KEY=change-this-in-production-use-a-strong-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_MINUTES=10080

FTGM_ENGINE_BASE_URL=http://localhost:8010/api/v1
FTGM_ENGINE_TIMEOUT_SECONDS=120

# Storage backend for uploaded files:
#   db    -> stored in Postgres (survives restarts; required on ephemeral hosts)
#   local -> written to STORAGE_ROOT on disk (local dev only)
STORAGE_BACKEND=db
STORAGE_ROOT=./storage
MAX_UPLOAD_SIZE_MB=10
# Comma-separated list of allowed MIME types
ALLOWED_UPLOAD_MIME_TYPES=text/csv,application/vnd.ms-excel,application/json

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
EMAILS_FROM_EMAIL=info@example.com
EMAILS_FROM_NAME="Inventory DSS"
